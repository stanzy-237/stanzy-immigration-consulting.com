// Prisma schema for Stanzy Immigration Consulting.
//
// Wires Prisma to Neon Postgres. Domain models (the Account → Lead → Client
// identity spine, Dossiers, the blog, etc.) are introduced by their own
// tickets, starting with auth (#4) below.
//
// Neon connection strings:
//   DATABASE_URL  — pooled (pgBouncer) URL used by the app at runtime.
//   DIRECT_URL    — direct (non-pooled) URL used for migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth (#4) ───────────────────────────────────────────────────────────────
// Shapes follow Better Auth's core schema. Better Auth's `user` model is our
// glossary Account; its own `account` model (one row per linked sign-in
// method) is AuthIdentity. See src/server/auth/create-auth.ts.

/// One person's login on the platform (GLOSSARY: Account).
model Account {
  id                String               @id
  name              String
  email             String               @unique
  emailVerified     Boolean              @default(false)
  image             String?
  /// Language the Account signed up in; drives email copy. `fr` | `en`.
  locale            String               @default("fr")
  /// Commercial journey; moves forward only (src/features/auth/lib/account-status.ts).
  status            AccountStatus        @default(USER)
  /// Access level; CONSULTANT comes only from CONSULTANT_EMAILS, PARTNER only
  /// from the consultant.
  role              AccountRole          @default(MEMBER)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  sessions          Session[]
  identities        AuthIdentity[]
  crsSimulations    CrsSimulation[]
  parcoursEtapes    ParcoursEtape[]
  pushSubscriptions PushSubscription[]
  budgetExpenses    BudgetExpense[]
  budgetProfile     BudgetProfile?
  blogPosts         BlogPost[]
  checklist         Checklist?
  dossiers          Dossier[]
  dossierEvents     DossierEvent[]
  dossierDocuments  DossierDocument[]
  documentVersions  DocumentVersion[]
  documentComments  DocumentComment[]
  paymentProofs     PaymentProof[]
  notifications     Notification[]       @relation("NotificationRecipient")
  notificationsMade Notification[]       @relation("NotificationActor")
  pdfToolFiles      PdfToolFile[]
  signatureRequests SignatureRequest[]   @relation("SignatureRequester")
  signaturesSigned  SignatureRequest[]   @relation("SignatureSigner")
  contractsSent     Contract[]           @relation("ContractSender")
  contractsSigned   Contract[]           @relation("ContractSigner")
  interestRequests  InterestRequest[]
  interestsDecided  InterestRequest[]    @relation("InterestDecider")
  stanzyRequests    StanzyRequest[]
  meetingsPlanned   Meeting[]
  meetingConsents   MeetingConsent[]
  meetingsInvited   MeetingParticipant[]
  meetingRequests   MeetingJoinRequest[]
  dossierMessages   DossierMessage[]
  incomesEntered    Income[]             @relation("IncomeCreator")
  chargesEntered    Charge[]             @relation("ChargeCreator")

  @@map("account")
}

/// GLOSSARY: User → Lead → Client.
enum AccountStatus {
  USER
  LEAD
  CLIENT
}

enum AccountRole {
  MEMBER
  PARTNER
  CONSULTANT
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  account   Account  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

/// A sign-in method linked to an Account: the email/password credential, or a
/// social provider such as Google.
model AuthIdentity {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  account               Account   @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("auth_identity")
}

/// Short-lived tokens (email verification, password reset).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Better Auth rate-limit counters, stored in the database so limits hold
/// across serverless instances.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// ─── Calculateur CRS (#5) ────────────────────────────────────────────────────

/// A saved set of CRS answers and the score the server computed for it.
model CrsSimulation {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  /// The answers (CrsProfile); re-scored by the engine whenever it is saved.
  profile   Json
  total     Int
  breakdown Json
  /// CRS rules version the score follows, e.g. "2025-03-25".
  rules     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, updatedAt])
  @@map("crs_simulation")
}

// ─── Derniers tirages (#49) ──────────────────────────────────────────────────

/// GLOSSARY: Type de tirage, as the filter chips group them.
enum DrawGroup {
  GENERAL
  PNP
  CEC
  FRENCH
  CATEGORY
}

/// One Entrée Express round from IRCC's feed (GLOSSARY: Tirage).
model Draw {
  /// IRCC's draw number as published: usually digits, once "91a"/"91b".
  round       String    @id
  roundNumber Int
  date        DateTime  @db.Date
  /// IRCC's drawName, as published (English).
  typeLabel   String
  group       DrawGroup
  invitations Int
  crsMin      Int
  irccUrl     String?
  /// The feed's object for this round, untouched.
  raw         Json
  firstSeenAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Set once the Alerte tirage went out (or, for the backfill, never will).
  notifiedAt  DateTime?

  @@index([date(sort: Desc), roundNumber(sort: Desc)])
  @@map("draw")
}

/// When ingestion last read IRCC's feed successfully. One row, id "ircc".
model DrawSync {
  id       String   @id
  syncedAt DateTime

  @@map("draw_sync")
}

/// One device opted in to Alertes tirages (Web Push).
model PushSubscription {
  endpoint      String   @id
  p256dh        String
  auth          String
  /// Language the alert is written in. `fr` | `en`.
  locale        String   @default("fr")
  accountId     String?
  account       Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  /// This device wants the Alertes tirages (every new Tirage).
  drawAlerts    Boolean  @default(true)
  /// This device wants its Account's Notifications pushed (#92), as general text.
  notifications Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([accountId])
  @@map("push_subscription")
}

// ─── Parcours (#10) ──────────────────────────────────────────────────────────

/// One dated milestone in an Account's Parcours (GLOSSARY: Étape).
model ParcoursEtape {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  label     String
  /// Short uppercase code shown on the pill, e.g. "ITA", "COPR".
  code      String
  emoji     String
  /// Palette key (src/features/parcours/data/palette.ts), never a hex.
  color     String
  /// The calendar day the Étape happened; no time, no zone.
  date      DateTime @db.Date
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, date])
  @@map("parcours_etape")
}

// ─── Budget & dépenses (#62) ─────────────────────────────────────────────────

/// One amount an Account logged as spent on its procedure (GLOSSARY: Dépense).
model BudgetExpense {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  /// Reason key (src/features/budget/data/motifs.ts), never a label.
  motif     String
  /// In the Account's currency's smallest unit: cents, or whole francs CFA.
  amount    Int
  /// The calendar day the money was spent; no time, no zone.
  date      DateTime @db.Date
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, date])
  @@map("budget_expense")
}

/// An Account's budget settings: its currency and its Estimation de budget.
model BudgetProfile {
  id        String   @id @default(cuid())
  accountId String   @unique
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// ISO code (src/features/budget/data/currencies.ts), null until the User
  /// picks one in « Mes dépenses ». Changing it never converts the amounts
  /// already logged.
  currency  String?
  /// No longer written or read: the estimate stays in the browser (#69
  /// follow-up). Kept so estimates saved earlier aren't dropped; remove it
  /// with a migration once that's fine.
  estimate  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("budget_profile")
}

// ─── Checklist Entrée Express (#76) ──────────────────────────────────────────

/// An Account's Checklist Entrée Express: its answers and the documents it ticked « Prêt ».
model Checklist {
  id        String   @id @default(cuid())
  accountId String   @unique
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// The form's answers (src/features/checklist/lib/checklist-form.ts); null until saved.
  answers   Json?
  /// `who:document` keys of the documents ticked « Prêt ».
  ready     String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("checklist")
}

/// GLOSSARY: Catégorie d'article. The consultant's own list; an Article has exactly one.
model BlogCategory {
  id        String     @id @default(cuid())
  slug      String     @unique
  nameFr    String
  nameEn    String
  /// Order in the Blog's filters, smallest first.
  position  Int        @default(0)
  posts     BlogPost[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("blog_category")
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

/// GLOSSARY: Article. A Blog post the consultant writes; Brouillon (DRAFT) or Publié.
model BlogPost {
  id             String         @id @default(cuid())
  slug           String         @unique
  /// The language it is written in: `fr` | `en`.
  locale         String         @default("fr")
  title          String
  excerpt        String?
  /// The rich-text document as Tiptap JSON, never HTML (src/features/blog/lib/render-article.ts).
  content        Json
  coverUrl       String?
  coverAlt       String?
  categoryId     String
  category       BlogCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Normalised tag slugs; their display text is the slug itself.
  tags           String[]       @default([])
  seoTitle       String?
  seoDescription String?
  status         BlogPostStatus @default(DRAFT)
  /// Set on the first publish only, kept through later edits and unpublishing.
  publishedAt    DateTime?
  readingMinutes Int            @default(1)
  authorId       String
  author         Account        @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, locale, publishedAt])
  @@map("blog_post")
}

// ─── Dossiers (#79) ──────────────────────────────────────────────────────────

/// The paid service a Dossier delivers; its stages are in src/features/dossiers/data/workflows.ts.
enum ServiceType {
  ACCOMPAGNEMENT
  VERIFICATION
  EDE
  SERVICE_DOCUMENTAIRE
}

/// OPEN until the consultant closes it (Clôturé, with a reason).
enum DossierState {
  OPEN
  CLOSED
}

/// GLOSSARY: Dossier. A Client's case file for one service, moved through its Workflow de service.
model Dossier {
  id            String           @id @default(cuid())
  accountId     String
  account       Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  service       ServiceType
  /// The current stage's key, one of the service's stages.
  stage         String
  /// The stage it opened at; the ones before it are « Déjà fait ».
  startStage    String
  state         DossierState     @default(OPEN)
  closedAt      DateTime?
  closedReason  String?
  events        DossierEvent[]
  sections      DossierSection[]
  invoices      Invoice[]
  contracts     Contract[]
  interest      InterestRequest?
  meetings      Meeting[]
  messages      DossierMessage[]
  incomes       Income[]
  charges       Charge[]
  notifications Notification[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([accountId, createdAt])
  @@index([state, updatedAt])
  @@map("dossier")
}

enum DossierEventKind {
  OPENED
  ADVANCED
  MOVED_BACK
  CLOSED
}

/// One change in a Dossier's history: who moved it, from which stage to which.
model DossierEvent {
  id        String           @id @default(cuid())
  dossierId String
  dossier   Dossier          @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  kind      DossierEventKind
  fromStage String?
  toStage   String
  /// The closing reason, for CLOSED.
  note      String?
  actorId   String
  actor     Account          @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt DateTime         @default(now())

  @@index([dossierId, createdAt])
  @@map("dossier_event")
}

/// A Section IRCC: one of the portal's upload boxes (« Diplômes – Requérant principal »), grouping Documents.
model DossierSection {
  id        String            @id @default(cuid())
  dossierId String
  dossier   Dossier           @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  title     String
  position  Int
  documents DossierDocument[]
  createdAt DateTime          @default(now())

  @@index([dossierId, position])
  @@map("dossier_section")
}

/// One Document in a Section (diplôme, relevé de notes…), with its Versions and one comment thread.
model DossierDocument {
  id             String             @id @default(cuid())
  sectionId      String
  section        DossierSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title          String
  addedById      String
  addedBy        Account            @relation(fields: [addedById], references: [id], onDelete: Restrict)
  /// The Version the consultant marked Finale.
  finalVersionId String?            @unique
  finalVersion   DocumentVersion?   @relation("FinalVersion", fields: [finalVersionId], references: [id], onDelete: SetNull)
  versions       DocumentVersion[]  @relation("Versions")
  comments       DocumentComment[]
  notifications  Notification[]
  signatures     SignatureRequest[]
  /// Made from the Checklist at approval (#81): its document, ★ Obligatoire or Recommandé.
  kind           String?
  need           String?
  /// The Client said they don't have it yet: « Manquant » until a Version comes.
  missing        Boolean            @default(false)
  /// The Client's note from their Demande d'intérêt, for this document's area.
  clientNote     String?
  stanzyRequests StanzyRequest[]
  createdAt      DateTime           @default(now())

  @@index([sectionId, createdAt])
  @@map("dossier_document")
}

/// One uploaded file of a Document (V1, V2…). Stored encrypted in R2 (ADR 0007, #87).
model DocumentVersion {
  id           String             @id @default(cuid())
  documentId   String
  document     DossierDocument    @relation("Versions", fields: [documentId], references: [id], onDelete: Cascade)
  finalOf      DossierDocument?   @relation("FinalVersion")
  number       Int
  fileName     String
  contentType  String
  /// The file's size before encryption, in bytes.
  size         Int
  /// Where the ciphertext sits in the private R2 bucket (#87).
  objectKey    String
  /// The file's own key, encrypted with DOSSIER_FILES_KEY.
  wrappedKey   String
  iv           String
  uploadedById String
  uploadedBy   Account            @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  /// The Demandes de signature sent with this Version as the original.
  signatures   SignatureRequest[] @relation("SignatureOriginal")
  /// The Demande de signature this Version is the signed result of.
  signedFor    SignatureRequest?  @relation("SignatureSigned")
  createdAt    DateTime           @default(now())

  @@unique([documentId, number])
  @@map("document_version")
}

/// A message in a Document's conversation: a comment, or a reply to one (one level deep).
model DocumentComment {
  id            String            @id @default(cuid())
  documentId    String
  document      DossierDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// The comment this one replies to; replies to a reply attach to its comment.
  parentId      String?
  parent        DocumentComment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       DocumentComment[] @relation("Replies")
  notifications Notification[]
  authorId      String
  author        Account           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body          String
  editedAt      DateTime?
  /// Deleted while it had replies: kept as « Commentaire supprimé » so the replies still make sense.
  deletedAt     DateTime?
  createdAt     DateTime          @default(now())

  @@index([documentId, createdAt])
  @@index([parentId])
  @@map("document_comment")
}

enum InvoiceCurrency {
  XAF
  CAD
  EUR
}

/// En retard is not stored: it is a SENT or PROOF_RECEIVED invoice past its due date.
enum InvoiceStatus {
  DRAFT
  SENT
  PROOF_RECEIVED
  PAID
  CANCELLED
}

/// A Facture, for one Dossier. Amounts are in the currency's minor unit (XAF has none, CAD and EUR cents).
model Invoice {
  id                String          @id @default(cuid())
  /// STZ-<year>-<0001>, given when it is sent, so drafts never burn a number.
  number            String?         @unique
  dossierId         String
  dossier           Dossier         @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  currency          InvoiceCurrency @default(XAF)
  status            InvoiceStatus   @default(DRAFT)
  dueDate           DateTime?
  /// Printed under the lines: payment instructions, a note to the Client.
  notes             String?
  lines             InvoiceLine[]
  proofs            PaymentProof[]
  notifications     Notification[]
  sentAt            DateTime?
  paidAt            DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  /// When the Client was reminded the due date is near, and that it passed (#92); each once.
  dueSoonRemindedAt DateTime?
  overdueRemindedAt DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([dossierId, createdAt])
  @@index([status, updatedAt])
  @@map("invoice")
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position    Int
  description String
  quantity    Int
  unitAmount  Int

  @@index([invoiceId, position])
  @@map("invoice_line")
}

/// The last invoice number given in a year.
model InvoiceCounter {
  year Int @id
  last Int

  @@map("invoice_counter")
}

/// A Preuve de paiement the Client uploaded on an invoice, encrypted like a Document (ADR 0007).
model PaymentProof {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fileName     String
  contentType  String
  size         Int
  /// Where the ciphertext sits in the private R2 bucket (#87).
  objectKey    String
  wrappedKey   String
  iv           String
  uploadedById String
  uploadedBy   Account  @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([invoiceId, createdAt])
  @@map("payment_proof")
}

/// What a Notification tells (#92). Its text is rendered in the reader's language, never stored.
enum NotificationKind {
  DOSSIER_OPENED
  DOSSIER_STAGE_CHANGED
  DOSSIER_CLOSED
  DOCUMENT_ADDED
  VERSION_UPLOADED
  MESSAGE_POSTED
  INVOICE_SENT
  INVOICE_PAID
  PROOF_RECEIVED
  /// To the Client, 3 days before a sent Facture's due date.
  INVOICE_DUE_SOON
  /// To the Client, the day a sent Facture becomes overdue.
  INVOICE_OVERDUE
  /// To the consultant, the same day: « En retard ».
  INVOICE_LATE
  /// To the consultant, once a day: the accounts created the day before.
  ACCOUNTS_SIGNED_UP
  /// A new Tirage, for Accounts with Alertes tirages on.
  DRAW_PUBLISHED
  /// To the Client: a Demande de signature to sign.
  SIGNATURE_REQUESTED
  /// To the consultant: the Client signed.
  DOCUMENT_SIGNED
  /// To the Client: a Contrat or an Avenant to sign.
  CONTRACT_SENT
  /// To the consultant: the Client signed a Contrat or an Avenant.
  CONTRACT_SIGNED
  /// To the consultant: a new Demande d'intérêt (#81).
  INTEREST_SUBMITTED
  /// To the User: their Demande d'intérêt was not accepted.
  INTEREST_REJECTED
  /// To the consultant: a Client asked Stanzy to get a Document.
  STANZY_REQUESTED
  /// To the Client: Stanzy won't get that Document.
  STANZY_DECLINED
  /// To the Client: a Réunion planned, moved or cancelled (#94).
  MEETING_SCHEDULED
  MEETING_MOVED
  MEETING_CANCELLED
  /// To the Client the day before and 15 minutes before; to the consultant 15 minutes before.
  MEETING_REMINDER
  /// To the consultant: someone with the invitation link asks to join.
  MEETING_JOIN_REQUEST
  /// To the other side: a message in the Dossier's « Messages » (#94).
  DOSSIER_MESSAGE
  /// To the Client, 3 then 7 days after a Demande de signature, if unsigned.
  SIGNATURE_REMINDER
  /// To the Client, 3 then 7 days after a Contrat or an Avenant, if unsigned.
  CONTRACT_REMINDER
}

/// One line in an Account's notification center. Repeats by the same actor on the same target, while unread and within 30 minutes, raise `count` instead of adding lines.
model Notification {
  id          String           @id @default(cuid())
  recipientId String
  recipient   Account          @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  kind        NotificationKind
  actorId     String?
  actor       Account?         @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  dossierId   String?
  dossier     Dossier?         @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  /// Deleting the Document (or the message) removes the Notification.
  documentId  String?
  document    DossierDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  commentId   String?
  comment     DocumentComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  invoiceId   String?
  invoice     Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  messageId   String?
  message     DossierMessage?  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// What the text needs beyond the relations: a stage key, a closing reason.
  params      Json             @default("{}")
  count       Int              @default(1)
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  /// The last time it was raised: the list is sorted by it.
  updatedAt   DateTime         @default(now())

  @@index([recipientId, updatedAt])
  @@index([recipientId, readAt])
  @@map("notification")
}

/// One run of a daily job on one day (Douala time), so a second call that day does nothing (#92).
model CronRun {
  job       String
  day       String
  createdAt DateTime @default(now())

  @@id([job, day])
  @@map("cron_run")
}

/// A PDF the consultant downloaded from the Outils PDF, kept encrypted in R2 for 90 days (its history).
model PdfToolFile {
  id          String   @id @default(cuid())
  name        String
  pageCount   Int
  /// The PDF's size in bytes, before encryption.
  size        Int
  /// What was done: merged, reordered, rotated, removed, compressed.
  changes     String[]
  /// The compression quality (0–1) when compressed.
  quality     Float?
  /// The names of the files it was made from.
  sourceNames String[]
  objectKey   String
  wrappedKey  String
  iv          String
  createdById String
  createdBy   Account  @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([createdById, createdAt])
  @@map("pdf_tool_file")
}

enum SignatureRequestStatus {
  PENDING
  SIGNED
  CANCELLED
}

/// A PDF the Client signs online (#96): a Version of a Document, with the fields
/// the consultant placed. Signing makes the signed PDF the Document's next Version.
model SignatureRequest {
  id              String                 @id @default(cuid())
  documentId      String
  document        DossierDocument        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// The PDF sent for signature.
  versionId       String
  version         DocumentVersion        @relation("SignatureOriginal", fields: [versionId], references: [id], onDelete: Cascade)
  /// SHA-256 (hex) of the original PDF, checked again before signing.
  fingerprint     String
  /// Where the fields sit: `{ kind, page, x, y, width, height }[]`, in fractions of the page from its top left.
  fields          Json
  status          SignatureRequestStatus @default(PENDING)
  requestedById   String
  requestedBy     Account                @relation("SignatureRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  /// The signed PDF, once signed.
  signedVersionId String?                @unique
  signedVersion   DocumentVersion?       @relation("SignatureSigned", fields: [signedVersionId], references: [id], onDelete: SetNull)
  signedById      String?
  signedBy        Account?               @relation("SignatureSigner", fields: [signedById], references: [id], onDelete: Restrict)
  /// The Certificat de signature: the name typed, when, from where.
  signedName      String?
  signedAt        DateTime?
  signedIp        String?
  signedDevice    String?
  cancelledAt     DateTime?
  /// Reminders sent to the Client: 1 at 3 days, 2 at 7 days, then none.
  reminders       Int                    @default(0)
  createdAt       DateTime               @default(now())

  @@index([documentId, status])
  @@index([status, createdAt])
  @@map("signature_request")
}

enum SigningAssetKind {
  SIGNATURE
  STAMP
}

/// The consultant's signature and the company stamp (cachet), uploaded once, encrypted in R2 (#96).
model SigningAsset {
  kind        SigningAssetKind @id
  contentType String
  objectKey   String
  wrappedKey  String
  iv          String
  updatedAt   DateTime         @updatedAt

  @@map("signing_asset")
}

/// A service contract template (#96), per service and language, written in the Tableau de bord.
/// Its blanks ({client}, {prix}…) are filled in when a Contrat is sent. Prices never live here.
model ContractTemplate {
  id        String      @id @default(cuid())
  service   ServiceType
  /// `fr` | `en`.
  locale    String
  title     String
  body      String
  updatedAt DateTime    @updatedAt

  @@unique([service, locale])
  @@map("contract_template")
}

enum ContractStatus {
  SENT
  SIGNED
  CANCELLED
}

/// The Contrats' numbers per year (CTR-<year>-<0001>), given when sent.
model ContractCounter {
  year Int @id
  last Int

  @@map("contract_counter")
}

/// A Contrat for a Dossier, or an Avenant to one (`parentId`), sent with the
/// consultant's signature and stamp and signed online by the Client (#96).
/// Its PDF is encrypted in R2 (ADR 0007); once signed, the signed PDF with
/// its Certificat de signature too. A signed Contrat never changes.
model Contract {
  id               String           @id @default(cuid())
  /// CTR-2026-0001, or CTR-2026-0001-A1 for an Avenant.
  number           String           @unique
  dossierId        String
  dossier          Dossier          @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  /// The Contrat this Avenant changes.
  parentId         String?
  parent           Contract?        @relation("Amendments", fields: [parentId], references: [id], onDelete: Restrict)
  amendments       Contract[]       @relation("Amendments")
  /// `fr` | `en`: the Client's language when sent.
  locale           String
  title            String
  /// The text as sent, its blanks filled in: what the Client signs.
  body             String
  /// Price, in the currency's minor unit, and the échéancier; a Contrat's only.
  amount           Int?
  currency         InvoiceCurrency?
  schedule         String?
  status           ContractStatus   @default(SENT)
  /// The PDF sent, with the consultant's signature and stamp.
  objectKey        String
  wrappedKey       String
  iv               String
  size             Int
  /// SHA-256 (hex) of that PDF, checked again before signing.
  fingerprint      String
  /// The Client's fields on it: `{ kind, page, x, y, width, height }[]`.
  fields           Json
  /// The signed PDF, with its Certificat de signature.
  signedObjectKey  String?
  signedWrappedKey String?
  signedIv         String?
  signedSize       Int?
  signedById       String?
  signedBy         Account?         @relation("ContractSigner", fields: [signedById], references: [id], onDelete: Restrict)
  signedName       String?
  signedAt         DateTime?
  signedIp         String?
  signedDevice     String?
  sentById         String
  sentBy           Account          @relation("ContractSender", fields: [sentById], references: [id], onDelete: Restrict)
  sentAt           DateTime         @default(now())
  cancelledAt      DateTime?
  cancelReason     String?
  /// Reminders sent to the Client: 1 at 3 days, 2 at 7 days, then none.
  reminders        Int              @default(0)

  @@index([dossierId, sentAt])
  @@index([status, sentAt])
  @@map("contract")
}

enum InterestStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

/// A, B or C: how far an Accompagnement candidate already is (GLOSSARY: Niveau).
enum InterestLevel {
  A
  B
  C
}

/// GLOSSARY: Demande d'intérêt (#81). Kept after the decision, as history.
model InterestRequest {
  id            String         @id @default(cuid())
  accountId     String
  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status        InterestStatus @default(SUBMITTED)
  /// The answers: the Checklist's, where they stand, and each document area (src/features/accompagnement/lib/interest-schema.ts).
  answers       Json
  /// Worked out from the answers; the consultant's choice, if any, wins.
  level         InterestLevel
  levelOverride InterestLevel?
  /// Where they live: « Stanzy s'en charge » is for Cameroon only.
  residence     String
  rejectReason  String?
  decidedById   String?
  decidedBy     Account?       @relation("InterestDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  /// The Accompagnement Dossier its approval opened.
  dossierId     String?        @unique
  dossier       Dossier?       @relation(fields: [dossierId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([accountId, createdAt])
  @@map("interest_request")
}

/// Demandé, then Accepté and Assigné once Services documentaires (#80) and Missions (#42) exist; or Refusé.
enum StanzyRequestStatus {
  REQUESTED
  ACCEPTED
  ASSIGNED
  DECLINED
}

/// « Stanzy s'en charge » (#81): a Client in Cameroon asks Stanzy to get a missing Document.
model StanzyRequest {
  id            String              @id @default(cuid())
  documentId    String
  document      DossierDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status        StanzyRequestStatus @default(REQUESTED)
  requestedById String
  requestedBy   Account             @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  /// Why the consultant declined: the Client gets the Document themselves.
  declineNote   String?
  decidedAt     DateTime?
  createdAt     DateTime            @default(now())

  @@index([documentId, status])
  @@index([status, createdAt])
  @@map("stanzy_request")
}

/// Planned ahead, started at once (« Réunion instantanée »), or the consultant's Salle personnelle, always open.
enum MeetingKind {
  SCHEDULED
  INSTANT
  PERSONAL
}

enum MeetingStatus {
  SCHEDULED
  CANCELLED
}

/// GLOSSARY: Réunion (#94). A video meeting planned from a Dossier, held in
/// the app on Stream Video, recorded and transcribed unless switched off.
model Meeting {
  id                String               @id @default(cuid())
  /// The Dossier it is about, if any: a Réunion can also stand on its own (a partner, a prospect).
  dossierId         String?
  dossier           Dossier?             @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  kind              MeetingKind          @default(SCHEDULED)
  subject           String
  description       String?
  /// The invitation link's secret: whoever is signed in and has it may ask to join.
  inviteToken       String               @unique
  /// « Terminer pour tous »: the call is over for everyone.
  endedAt           DateTime?
  startsAt          DateTime
  durationMinutes   Int
  /// Recorded and transcribed; the consultant may switch it off for one Réunion.
  recording         Boolean              @default(true)
  status            MeetingStatus        @default(SCHEDULED)
  /// The consultant's private notes; the Client never sees them.
  notes             String?
  plannedById       String
  plannedBy         Account              @relation(fields: [plannedById], references: [id], onDelete: Restrict)
  cancelledAt       DateTime?
  cancelReason      String?
  /// When each reminder went out; moving the Réunion clears them.
  remindedDayBefore DateTime?
  remindedSoon      DateTime?
  consents          MeetingConsent[]
  recordings        MeetingRecording[]
  participants      MeetingParticipant[]
  joinRequests      MeetingJoinRequest[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([dossierId, startsAt])
  @@index([status, startsAt])
  @@map("meeting")
}

/// « Cette réunion est enregistrée »: accepted by someone before joining, with the time.
model MeetingConsent {
  id         String   @id @default(cuid())
  meetingId  String
  meeting    Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  acceptedAt DateTime @default(now())

  @@unique([meetingId, accountId])
  @@map("meeting_consent")
}

enum MeetingFileKind {
  RECORDING
  TRANSCRIPTION
}

/// GLOSSARY: Enregistrement, Transcription. A file Stream made of a Réunion,
/// stored in the private bucket through Stream's external storage; for the
/// consultant only, kept until 2 years after the Dossier is closed.
model MeetingRecording {
  id        String          @id @default(cuid())
  meetingId String
  meeting   Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  kind      MeetingFileKind
  /// Stream's file name, and where it put the file: its own address (valid about 2 weeks) and, once found, our bucket's key.
  filename  String
  url       String
  objectKey String?
  startedAt DateTime
  endedAt   DateTime
  /// A Transcription's words, for searching.
  text      String?
  createdAt DateTime        @default(now())

  @@unique([meetingId, kind, filename])
  @@map("meeting_recording")
}

/// GLOSSARY: Messages du dossier (#94). The Dossier's general conversation
/// between its Client and the consultant, apart from the Documents'.
model DossierMessage {
  id            String               @id @default(cuid())
  dossierId     String
  dossier       Dossier              @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  /// The message this one replies to; replies to a reply attach to its message.
  parentId      String?
  parent        DossierMessage?      @relation("MessageReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       DossierMessage[]     @relation("MessageReplies")
  authorId      String
  author        Account              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  /// May be empty when files are attached.
  body          String
  files         DossierMessageFile[]
  notifications Notification[]
  editedAt      DateTime?
  /// Deleted while it had replies: kept as « Message supprimé », without its words or files.
  deletedAt     DateTime?
  createdAt     DateTime             @default(now())

  @@index([dossierId, createdAt])
  @@index([parentId])
  @@map("dossier_message")
}

/// A file attached to a Dossier message, encrypted in the private bucket (ADR 0007).
model DossierMessageFile {
  id          String         @id @default(cuid())
  messageId   String
  message     DossierMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName    String
  contentType String
  size        Int
  objectKey   String
  wrappedKey  String
  iv          String
  createdAt   DateTime       @default(now())

  @@index([messageId])
  @@map("dossier_message_file")
}

/// GLOSSARY: Recette, entered by hand (#95): cash, a payment outside the
/// platform. A Facture marked Payée is a Recette by itself and has no row here.
model Income {
  id          String          @id @default(cuid())
  /// In the currency's minor unit, like Factures.
  amount      Int
  currency    InvoiceCurrency
  /// The day it came in.
  date        DateTime        @db.Date
  /// The service it pays for, or where it came from otherwise.
  service     ServiceType?
  source      String?
  dossierId   String?
  dossier     Dossier?        @relation(fields: [dossierId], references: [id], onDelete: SetNull)
  note        String?
  createdById String
  createdBy   Account         @relation("IncomeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([date])
  @@index([dossierId])
  @@map("income")
}

/// A Charge's category (#95); the consultant edits the list. Archived ones
/// keep their Charges but aren't offered any more.
model ChargeCategory {
  id         String    @id @default(cuid())
  name       String    @unique
  position   Int       @default(0)
  archivedAt DateTime?
  charges    Charge[]
  createdAt  DateTime  @default(now())

  @@map("charge_category")
}

/// GLOSSARY: Charge (#95). One that repeats every month is the model its
/// monthly copies are made from by the daily round.
model Charge {
  id                 String          @id @default(cuid())
  amount             Int
  currency           InvoiceCurrency
  date               DateTime        @db.Date
  categoryId         String
  category           ChargeCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  dossierId          String?
  dossier            Dossier?        @relation(fields: [dossierId], references: [id], onDelete: SetNull)
  note               String?
  /// A model: copied every month on the same day until switched off.
  repeatsMonthly     Boolean         @default(false)
  /// A copy: its model, and the `YYYY-MM` it was made for (each once).
  repeatOfId         String?
  repeatOf           Charge?         @relation("ChargeRepeats", fields: [repeatOfId], references: [id], onDelete: SetNull)
  copies             Charge[]        @relation("ChargeRepeats")
  repeatMonth        String?
  /// The receipt, encrypted in the private bucket (ADR 0007).
  receiptFileName    String?
  receiptContentType String?
  receiptSize        Int?
  receiptObjectKey   String?
  receiptWrappedKey  String?
  receiptIv          String?
  createdById        String
  createdBy          Account         @relation("ChargeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([repeatOfId, repeatMonth])
  @@index([date])
  @@index([dossierId])
  @@index([repeatsMonthly])
  @@map("charge")
}

/// What 1 CAD is worth in XAF for a month (#95), entered by the consultant.
/// EUR needs none: it is fixed at 655.957.
model CadRate {
  /// `YYYY-MM`.
  month     String   @id
  xafPerCad Decimal  @db.Decimal(12, 4)
  updatedAt DateTime @updatedAt

  @@map("cad_rate")
}

/// Who is invited to a Réunion besides the consultant: Clients and partners, each with an account.
model MeetingParticipant {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([meetingId, accountId])
  @@index([accountId])
  @@map("meeting_participant")
}

enum JoinRequestStatus {
  PENDING
  ADMITTED
  REFUSED
}

/// Someone signed in, with the invitation link, but not invited: they wait until the consultant lets them in.
model MeetingJoinRequest {
  id        String            @id @default(cuid())
  meetingId String
  meeting   Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  accountId String
  account   Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status    JoinRequestStatus @default(PENDING)
  createdAt DateTime          @default(now())
  decidedAt DateTime?

  @@unique([meetingId, accountId])
  @@index([meetingId, status])
  @@map("meeting_join_request")
}
