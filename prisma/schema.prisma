// Prisma schema for Stanzy Immigration Consulting.
//
// Wires Prisma to Neon Postgres. Domain models (the Account → Lead → Client
// identity spine, Dossiers, the blog, etc.) are introduced by their own
// tickets, starting with auth (#4) below.
//
// Neon connection strings:
//   DATABASE_URL  — pooled (pgBouncer) URL used by the app at runtime.
//   DIRECT_URL    — direct (non-pooled) URL used for migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth (#4) ───────────────────────────────────────────────────────────────
// Shapes follow Better Auth's core schema. Better Auth's `user` model is our
// glossary Account; its own `account` model (one row per linked sign-in
// method) is AuthIdentity. See src/server/auth/create-auth.ts.

/// One person's login on the platform (GLOSSARY: Account).
model Account {
  id                String             @id
  name              String
  email             String             @unique
  emailVerified     Boolean            @default(false)
  image             String?
  /// Language the Account signed up in; drives email copy. `fr` | `en`.
  locale            String             @default("fr")
  /// Commercial journey; moves forward only (src/features/auth/lib/account-status.ts).
  status            AccountStatus      @default(USER)
  /// Access level; CONSULTANT comes only from CONSULTANT_EMAILS, PARTNER only
  /// from the consultant.
  role              AccountRole        @default(MEMBER)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sessions          Session[]
  identities        AuthIdentity[]
  crsSimulations    CrsSimulation[]
  parcoursEtapes    ParcoursEtape[]
  pushSubscriptions PushSubscription[]
  budgetExpenses    BudgetExpense[]
  budgetProfile     BudgetProfile?

  @@map("account")
}

/// GLOSSARY: User → Lead → Client.
enum AccountStatus {
  USER
  LEAD
  CLIENT
}

enum AccountRole {
  MEMBER
  PARTNER
  CONSULTANT
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  account   Account  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

/// A sign-in method linked to an Account: the email/password credential, or a
/// social provider such as Google.
model AuthIdentity {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  account               Account   @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("auth_identity")
}

/// Short-lived tokens (email verification, password reset).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Better Auth rate-limit counters, stored in the database so limits hold
/// across serverless instances.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// ─── Calculateur CRS (#5) ────────────────────────────────────────────────────

/// A saved set of CRS answers and the score the server computed for it.
model CrsSimulation {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  /// The answers (CrsProfile); re-scored by the engine whenever it is saved.
  profile   Json
  total     Int
  breakdown Json
  /// CRS rules version the score follows, e.g. "2025-03-25".
  rules     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, updatedAt])
  @@map("crs_simulation")
}

// ─── Derniers tirages (#49) ──────────────────────────────────────────────────

/// GLOSSARY: Type de tirage, as the filter chips group them.
enum DrawGroup {
  GENERAL
  PNP
  CEC
  FRENCH
  CATEGORY
}

/// One Entrée Express round from IRCC's feed (GLOSSARY: Tirage).
model Draw {
  /// IRCC's draw number as published: usually digits, once "91a"/"91b".
  round       String    @id
  roundNumber Int
  date        DateTime  @db.Date
  /// IRCC's drawName, as published (English).
  typeLabel   String
  group       DrawGroup
  invitations Int
  crsMin      Int
  irccUrl     String?
  /// The feed's object for this round, untouched.
  raw         Json
  firstSeenAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Set once the Alerte tirage went out (or, for the backfill, never will).
  notifiedAt  DateTime?

  @@index([date(sort: Desc), roundNumber(sort: Desc)])
  @@map("draw")
}

/// When ingestion last read IRCC's feed successfully. One row, id "ircc".
model DrawSync {
  id       String   @id
  syncedAt DateTime

  @@map("draw_sync")
}

/// One device opted in to Alertes tirages (Web Push).
model PushSubscription {
  endpoint  String   @id
  p256dh    String
  auth      String
  /// Language the alert is written in. `fr` | `en`.
  locale    String   @default("fr")
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([accountId])
  @@map("push_subscription")
}

// ─── Parcours (#10) ──────────────────────────────────────────────────────────

/// One dated milestone in an Account's Parcours (GLOSSARY: Étape).
model ParcoursEtape {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  label     String
  /// Short uppercase code shown on the pill, e.g. "ITA", "COPR".
  code      String
  emoji     String
  /// Palette key (src/features/parcours/data/palette.ts), never a hex.
  color     String
  /// The calendar day the Étape happened; no time, no zone.
  date      DateTime @db.Date
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, date])
  @@map("parcours_etape")
}

// ─── Budget & dépenses (#62) ─────────────────────────────────────────────────

/// One amount an Account logged as spent on its procedure (GLOSSARY: Dépense).
model BudgetExpense {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  /// Reason key (src/features/budget/data/motifs.ts), never a label.
  motif     String
  /// In the Account's currency's smallest unit: cents, or whole francs CFA.
  amount    Int
  /// The calendar day the money was spent; no time, no zone.
  date      DateTime @db.Date
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, date])
  @@map("budget_expense")
}

/// An Account's budget settings: its currency and its Estimation de budget.
model BudgetProfile {
  id        String   @id @default(cuid())
  accountId String   @unique
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// ISO code (src/features/budget/data/currencies.ts), null until the User
  /// picks one in « Mes dépenses ». Changing it never converts the amounts
  /// already logged.
  currency  String?
  /// No longer written or read: the estimate stays in the browser (#69
  /// follow-up). Kept so estimates saved earlier aren't dropped; remove it
  /// with a migration once that's fine.
  estimate  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("budget_profile")
}
