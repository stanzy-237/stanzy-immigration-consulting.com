[
  {
    "name": "Rate limit: sign-in, sign-up, password reset",
    "description": "#163. POSTs to Better Auth's credential endpoints, 30/min per IP (Better Auth adds 3-5/min per IP behind it). Generous for shared mobile IPs.",
    "active": true,
    "conditionGroup": [
      {
        "conditions": [
          {
            "type": "method",
            "op": "eq",
            "value": "POST"
          },
          {
            "type": "path",
            "op": "pre",
            "value": "/api/auth/sign-in/"
          }
        ]
      },
      {
        "conditions": [
          {
            "type": "method",
            "op": "eq",
            "value": "POST"
          },
          {
            "type": "path",
            "op": "pre",
            "value": "/api/auth/sign-up/"
          }
        ]
      },
      {
        "conditions": [
          {
            "type": "method",
            "op": "eq",
            "value": "POST"
          },
          {
            "type": "path",
            "op": "pre",
            "value": "/api/auth/request-password-reset"
          }
        ]
      },
      {
        "conditions": [
          {
            "type": "method",
            "op": "eq",
            "value": "POST"
          },
          {
            "type": "path",
            "op": "pre",
            "value": "/api/auth/reset-password"
          }
        ]
      },
      {
        "conditions": [
          {
            "type": "method",
            "op": "eq",
            "value": "POST"
          },
          {
            "type": "path",
            "op": "pre",
            "value": "/api/auth/send-verification-email"
          }
        ]
      },
      {
        "conditions": [
          {
            "type": "method",
            "op": "eq",
            "value": "POST"
          },
          {
            "type": "path",
            "op": "pre",
            "value": "/api/auth/two-factor/"
          }
        ]
      }
    ],
    "action": {
      "mitigate": {
        "action": "rate_limit",
        "rateLimit": {
          "algo": "fixed_window",
          "window": 60,
          "limit": 30,
          "keys": [
            "ip"
          ],
          "action": "rate_limit"
        }
      }
    }
  },
