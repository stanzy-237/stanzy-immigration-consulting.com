# Neon Postgres connection strings.
# Create a project at https://neon.tech and copy the connection strings from the
# dashboard. Use the *pooled* string for DATABASE_URL and the *direct* string
# (unpooled) for DIRECT_URL, which Prisma uses for migrations.
# connect_timeout=15: Neon suspends an idle database, and waking it over a slow
# connection can take longer than Prisma's 5 s default ("Can't reach database server").
# pool_timeout=20: a query waits longer for a connection than one takes to open,
# or it gives up first ("Timed out fetching a new connection from the connection pool").
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&connect_timeout=15&pool_timeout=20"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require&connect_timeout=15&pool_timeout=20"

# Set to any value to skip env validation during lint/typecheck/CI builds that
# have no database available.
# SKIP_ENV_VALIDATION=1

# ─── Auth (Better Auth, #4) ──────────────────────────────────────────────────
# Signs session cookies and verification tokens. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public origin of the app. Required in Vercel production; previews derive it
# from VERCEL_URL.
BETTER_AUTH_URL="http://localhost:3000"
# Production only: the parent domain, so one sign-in covers the site and the
# Tableau de bord on admin.<site>. Leave unset locally and on previews.
# AUTH_COOKIE_DOMAIN="stanzy-immigration-consulting.com"

# ─── Google sign-in ("Continuer avec Google", #29) ──────────────────────────
# OAuth client from Google Cloud Console; walk through it with
#   ./scripts/setup-google-sign-in.sh
# Optional: without them the Google button is hidden. Set both or neither.
# GOOGLE_CLIENT_ID="1234567890-abc123.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-..."

# ─── Consultant role (#33) ───────────────────────────────────────────────────
# Comma-separated emails whose Account becomes the consultant when created
# (sign-up or first Google sign-in). Optional: without it nobody is consultant.
# Accounts created before an email is added keep their role.
# CONSULTANT_EMAILS="you@your-domain.com"

# ─── Transactional email (Resend) ────────────────────────────────────────────
# Without RESEND_API_KEY, emails are printed to the server console instead.
# RESEND_API_KEY="re_..."
# Required once RESEND_API_KEY is set; must be on a domain verified in Resend.
# EMAIL_FROM="Stanzy Immigration <noreply@your-domain.com>"

# ─── Derniers tirages (#49) ──────────────────────────────────────────────────
# Shared secret for POST /api/cron/draws. The hourly GitHub Actions workflow
# (.github/workflows/ingest-draws.yml) sends it; store the same value as the
# repo secret CRON_SECRET, next to DRAWS_INGEST_URL
# (https://your-domain.com/api/cron/draws). Generate with:
#   openssl rand -base64 32
# CRON_SECRET=""

# Web Push keys for Alertes tirages. Generate once with:
#   npx web-push generate-vapid-keys
# Optional: without them the alert button is hidden. Set all three or none.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@your-domain.com"

# ─── Documents de service (#79) ──────────────────────────────────────────────
# Encrypts each uploaded document's own key (ADR 0007). Generate once with
#   openssl rand -base64 32
# and never change it: files saved under the old key could no longer be read.
# Optional: without it, Dossier uploads are refused. The files themselves go
# to the private R2 bucket below.
# DOSSIER_FILES_KEY=

# ─── File storage: Cloudflare R2 (#87) ───────────────────────────────────────
# Every file the app stores. Walk through it with ./scripts/setup-r2.sh.
# One API token with "Object Read & Write" on both buckets. Optional: without
# them uploads are refused. Set all five or none.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Documents de service and Preuves de paiement (ciphertext only, ADR 0007).
# R2_PRIVATE_BUCKET=
# Blog images and the TikTok carousel, read directly by visitors.
# R2_PUBLIC_BUCKET=
# Where the public bucket is served: its custom domain or r2.dev address,
# without a trailing slash. Also read at build time (next.config.ts images).
# NEXT_PUBLIC_R2_PUBLIC_URL=
